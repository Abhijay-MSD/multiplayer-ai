# Supabase project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=
# Supabase service_role secret key (server only, never the anon key). Project Settings -> API -> service_role.
SUPABASE_SERVICE_KEY=
# Which model provider answers: gemini, groq, claude or compat (an OpenAI-compatible service). On a local copy this and the keys below can be set in Settings instead; a variable set here overrides what Settings saved. See docs/providers.md.
PROVIDER=
# Groq API key (when PROVIDER=groq). Create one at https://console.groq.com/keys
GROQ_API_KEY=
# Groq model; blank uses openai/gpt-oss-120b. List what your key can use: https://console.groq.com/docs/models
GROQ_MODEL=
# Used when the primary still fails after retries: 429/503, or a 400 "Parsing failed" from gpt-oss. Verified on a live key; blank disables the fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Model for rolling summaries; blank uses openai/gpt-oss-20b.
GROQ_SUMMARY_MODEL=
# Reasoning effort for the gpt-oss models: low (default), medium, high, or none.
GROQ_REASONING_EFFORT=
# Claude API key (when PROVIDER=claude). Create one in the provider's console (console.anthropic.com). Not yet checked against the real service; see docs/providers.md.
ANTHROPIC_API_KEY=
# Claude model; blank uses claude-haiku-4-5-20251001 (a default that was not confirmed against the provider's model list).
ANTHROPIC_MODEL=
# Gemini API key. Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Primary Gemini model; blank uses gemini-3.5-flash. List the models your key can use at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Model used when the primary still returns 503/429 after 3 retries; blank disables the fallback.
GEMINI_FALLBACK_MODEL=
# Port for the REST API the web app calls (e.g. 3001); blank means MCP stdio only, and the web app will not work.
PORT=
# Public base URL of the web app, used in shareable links (e.g. http://localhost:5173 in dev).
PUBLIC_URL=
# Max agent steps per session before it stops; blank uses 50.
MAX_STEPS_PER_SESSION=
# Approx. token budget for the context sent to the model each step (system prompt, pinned task, summary, recent events); blank uses 6000.
MAX_CONTEXT_TOKENS=
# Gemini thinking level for replies: minimal, low, medium, high, or none to leave it to the model; blank uses minimal.
GEMINI_THINKING_LEVEL=
# How long a participant's access token lasts, in days; blank uses 30.
TOKEN_TTL_DAYS=
# Milliseconds between keep-alive pings on the live stream; kept between 15000 and 25000. Blank uses 20000.
STREAM_PING_MS=
# Cap on the reply length a step asks the model for, in tokens. Blank: Claude is asked for up to 16000 tokens (its API needs a number), and Groq, Gemini and an OpenAI-compatible service get no cap from us, so their own default applies, which depends on the provider, the model and your account. Room for the model's thinking is added on top for Groq and Gemini, so this limits the answer, not the reasoning. A reply the provider cuts at its length limit is saved, and the room is shown "The reply reached its length limit" with a Continue button for the controller.
MAX_OUTPUT_TOKENS=
# Days without any new event before a room becomes read-only (archived); blank uses 7. Worked out when the room is read, nothing sweeps.
ARCHIVE_AFTER_DAYS=

# ── Cost and abuse limits ─────────────────────────────────────────
# Every default below is a placeholder. Set them to fit your provider's quota and your traffic.
# A blank value uses the default shown; a value that is set but is not a whole number above 0 stops the server at startup.
# See docs/limits.md.
# Agent replies allowed per UTC day across all rooms (stored in the database, so a restart doesn't refill it); blank uses 200. When spent, new steps are refused with "at capacity".
DAILY_STEP_BUDGET=
# Rooms one IP address may start per hour; blank uses 5.
CREATE_LIMIT_PER_HOUR=
# New people one IP address may add to rooms per hour (returning with a valid token is free); blank uses 30.
JOIN_LIMIT_PER_HOUR=
# Messages to the agent per person per room per minute; blank uses 6.
DIRECTIVE_LIMIT_PER_MIN=
# Room comments per person per room per minute; blank uses 20.
COMMENT_LIMIT_PER_MIN=
# People one room may hold; blank uses 25.
MAX_PARTICIPANTS_PER_ROOM=
# Longest task, message or comment in characters; blank uses 4000. Can be lowered, not raised (the database and the web inputs stop at 4000).
MAX_MESSAGE_CHARS=
# Longest session title in characters; longer ones are cut. Blank uses 120. Can be lowered, not raised.
MAX_TITLE_CHARS=
# Largest JSON request body in KB; blank uses 32.
MAX_BODY_KB=
# How many proxies sit in front of this server, for working out each caller's IP; blank or 0 trusts none. Set it to the real number of hops or the per-IP limits are wrong: too high lets callers pick their own IP, too low puts everyone behind the proxy in one shared limit. See docs/limits.md.
TRUST_PROXY_HOPS=
# Set to production on a deployed server; PUBLIC_URL is then required.
NODE_ENV=

# ── Storage and where it runs (local copy) ───────────────────────
# Where the data file lives; blank uses a folder named .multiplayer-ai in your home folder. Owner-only.
MULTIPLAYER_AI_DATA_DIR=
# Storage: sqlite (default, a local file), supabase (needs the settings at the top, and its library: cd server/supabase-lib && npm ci; see docs/supabase.md), memory (tests).
MULTIPLAYER_AI_STORE=
# Port for npm start; blank uses 3737. If it is busy, a free one is used and the real address is printed.
MULTIPLAYER_AI_PORT=
# Set to anything to keep npm start from opening your browser.
NO_OPEN=
# wifi lets devices on the same Wi-Fi in, for this run only (the same as npm start -- --share=wifi); blank or local means this computer only. Never remembered. See docs/sharing.md.
MULTIPLAYER_AI_SHARE=
# In a container only: the address people will use to reach this computer, e.g. 192.168.1.20 or my-laptop.local. See docs/sharing.md.
MULTIPLAYER_AI_SHARE_ADDRESS=
# Messages to the agent that people other than the host may send in one shared room; blank uses 20. The host can change it per room.
GUEST_STEP_CAP_PER_ROOM=
# Wrong room secrets one address may try in 10 minutes before it is slowed down; blank uses 50.
INVITE_FAILURES_PER_10_MIN=

# ── An OpenAI-compatible provider (PROVIDER=compat) ──────────────
# Address of the service, e.g. https://api.example.com/v1 (https only; http is allowed for this computer, e.g. http://localhost:11434/v1).
OPENAI_COMPAT_BASE_URL=
# Its key. A model running on this computer may not need one.
OPENAI_COMPAT_API_KEY=
# The model name to ask for (required).
OPENAI_COMPAT_MODEL=

# ── Room files and the agent's tool loop ──────────────────────────
# The agent can list, read and write text files kept in the room (see docs/limits.md). Blank uses the default shown.
# Largest single file, in KB (1 KB = 1024 bytes); blank uses 200.
MAX_FILE_KB=
# Files one room may hold; blank uses 50.
MAX_FILES_PER_ROOM=
# Most a room may hold in all, in KB, counting every kept version of every file; blank uses 2048 (2 MB).
MAX_ROOM_FILES_KB=
# File tool calls the agent may make to answer one message; blank uses 12.
TOOL_CALLS_PER_DIRECTIVE=
# Model calls the agent may make to answer one message when it uses file tools; blank uses 8.
MODEL_CALLS_PER_DIRECTIVE=
# Most a tool's result may hold when it is fed back to the model, in KB; blank uses 20. A longer file is cut.
TOOL_RESULT_KB=
# Seconds the agent may take to answer one message when it uses file tools; blank uses 120.
DIRECTIVE_SECONDS=
# Model calls one room may make in all; blank uses 200.
MODEL_CALLS_PER_ROOM=
