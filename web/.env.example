# The web app holds no database credentials: it talks only to the server's API.
# Full URL of that API when the web app is hosted apart from it (a static host), e.g. https://api.example.com.
# Blank means same origin, which the dev proxy below provides locally.
VITE_API_URL=
# Where the dev proxy forwards /api (the server's PORT), e.g. http://localhost:3001; blank uses that default.
VITE_API_BASE=
# The repository URL, shown as a link on the landing page. Blank hides the link.
VITE_GITHUB_URL=https://github.com/Abhijay-MSD/multiplayer-ai
# Must equal the server's MAX_STEPS_PER_SESSION so the "step limit" signal is accurate; blank uses 50.
VITE_MAX_STEPS_PER_SESSION=
